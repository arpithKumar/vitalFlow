<?xml version="1.0" encoding="utf-8"?>
<!--
    VitalFlow does not use Android's automatic backup or phone-to-phone transfer. Health data is kept in
    the user's own Firestore account instead (Sync Now, then sign in on the new device), and the database
    and preferences hold secrets that cannot be restored on another device. Restoring an old local copy
    would also fight with that cloud copy. Everything is excluded from both paths, on purpose.

    To allow backup of something later, remove the matching exclude and say why in the commit.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
