<resources>

    <style name="Base.Theme.VitalFlow" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar blends with gradient pages -->
        <item name="android:statusBarColor">@color/page_gradient_start</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.VitalFlow" parent="Base.Theme.VitalFlow" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.VitalFlow</item>
    </style>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  SHAPE STYLES (unchanged)                       -->
    <!-- ═══════════════════════════════════════════════ -->
    <style name="CircleImageStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  BOTTOM SHEET STYLES (unchanged)                -->
    <!-- ═══════════════════════════════════════════════ -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  TYPOGRAPHY SCALE                               -->
    <!-- ═══════════════════════════════════════════════ -->

    <!-- 32sp — large screen titles, hero numbers -->
    <style name="TextAppearance.VitalFlow.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 24sp — section page titles ("Good Morning") -->
    <style name="TextAppearance.VitalFlow.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 18sp — card titles, fragment headers -->
    <style name="TextAppearance.VitalFlow.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 16sp — sub-headers, chip labels, button text -->
    <style name="TextAppearance.VitalFlow.Subheading" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 14sp — body text, card descriptions -->
    <style name="TextAppearance.VitalFlow.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 12sp — timestamps, badges, helper text -->
    <style name="TextAppearance.VitalFlow.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- 11sp — nav bar labels, micro badges -->
    <style name="TextAppearance.VitalFlow.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

</resources>