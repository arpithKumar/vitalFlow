<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0D2137"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvWidgetMedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEXT MEDICATION"
        android:textColor="#8040C4B0"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:id="@+id/tvWidgetMedName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="No meds due"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetMedTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="#8040C4B0"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvWidgetMedDosage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#66FFFFFF"
        android:textSize="12sp" />

</LinearLayout>
