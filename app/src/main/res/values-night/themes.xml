<resources>

    <style name="Base.Theme.VitalFlow" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar blends with dark gradient pages -->
        <item name="android:statusBarColor">@color/page_gradient_start</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.VitalFlow" parent="Base.Theme.VitalFlow" />

    <!-- OLED variant: true black window background -->
    <style name="Theme.VitalFlow.OLED" parent="Base.Theme.VitalFlow">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.VitalFlow</item>
    </style>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  SHAPE STYLES (unchanged)                       -->
    <!-- ═══════════════════════════════════════════════ -->
    <style name="CircleImageStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  BOTTOM SHEET STYLES (unchanged)                -->
    <!-- ═══════════════════════════════════════════════ -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- ═══════════════════════════════════════════════ -->
    <!--  TYPOGRAPHY SCALE (same definitions — @color tokens auto-switch) -->
    <!-- ═══════════════════════════════════════════════ -->

    <style name="TextAppearance.VitalFlow.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VitalFlow.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VitalFlow.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VitalFlow.Subheading" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VitalFlow.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.VitalFlow.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.VitalFlow.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

</resources>