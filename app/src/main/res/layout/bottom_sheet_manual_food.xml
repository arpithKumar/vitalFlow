<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="32dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/shape_drag_handle" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:text="Log Food"
        android:textAppearance="@style/TextAppearance.VitalFlow.Headline"
        android:textColor="@color/text_primary" />

    <!-- Food Name card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/glass_card_bg_elevated"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/glass_card_stroke"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFoodName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Food name *"
            app:boxBackgroundMode="none"
            app:hintTextColor="@color/text_secondary"
            app:boxStrokeColor="@color/glass_card_stroke"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:paddingHorizontal="4dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:imeOptions="actionNext"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.VitalFlow.Body" />
        </com.google.android.material.textfield.TextInputLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Calories card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/glass_card_bg_elevated"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/glass_card_stroke"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Calories (kcal) *"
            app:boxBackgroundMode="none"
            app:hintTextColor="@color/text_secondary"
            app:boxStrokeColor="@color/glass_card_stroke"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:paddingHorizontal="4dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.VitalFlow.Body" />
        </com.google.android.material.textfield.TextInputLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Macros card (optional) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/glass_card_bg_elevated"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/glass_card_stroke"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMacros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Macros (optional)"
            app:helperText="e.g. P: 30g, C: 45g, F: 10g"
            app:helperTextTextColor="@color/text_secondary"
            app:boxBackgroundMode="none"
            app:hintTextColor="@color/text_secondary"
            app:boxStrokeColor="@color/glass_card_stroke"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:paddingHorizontal="4dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMacros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:imeOptions="actionDone"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.VitalFlow.Body" />
        </com.google.android.material.textfield.TextInputLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Save button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveFood"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:text="Log Food"
        android:textColor="@color/text_on_primary"
        android:textAppearance="@style/TextAppearance.VitalFlow.Title"
        app:backgroundTint="@color/primary"
        app:cornerRadius="16dp" />

</LinearLayout>
